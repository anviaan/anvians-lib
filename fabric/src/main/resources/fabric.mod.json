{
  "schemaVersion": 1,
  "id": "anvianslib",
  "version": "${version}",
  "name": "Anvian's Lib",
  "description": "A small utility library for Anvian's mods.",
  "authors": [
    "anvian"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/anvians-lib",
    "sources": "https://github.com/anviaan/anvians-lib",
    "issues": "https://github.com/anviaan/anvians-lib/issues"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.curseforge": "https://www.curseforge.com/minecraft/mc-mods/anvians-lib",
        "modmenu.modrinth": "https://modrinth.com/mod/anvians-lib"
      },
      "badges": [
        "library"
      ]
    }
  },
  "license": "GPL-3.0",
  "icon": "anvianslib.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.anvian.anvianslib.fabric.FabricMod"
    ]
  },
  "mixins": [
    "anvianslib.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": ">=1.19",
    "java": ">=17",
    "fabric": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
